# 本机环境、缓存、构建输出和凭证
__pycache__/
*.py[cod]
*.whl
*.egg-info/
*.part
*.log
.venv/
venv/
.env
.env.*
!.env.example
*.pyd
third_party/**/build/
Ultralytics/
/config/local.json
/config/*.local.json
/Smart_Campus_GPU_Agent_Prompt.md
/environments/*.audit.txt

# 数据目录只允许随代码分发的固定公开样例。
/data/*
!/data/scenes/
/data/scenes/*
!/data/scenes/plant/
/data/scenes/plant/*
!/data/scenes/plant/plant.splat
!/data/scenes/plant/scene.ply
